{
  "name": "npi-workspace",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "setup": "tsx scripts/setup.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/npi-unit.test.ts tests/npi-file-validation.test.ts tests/build-config.test.ts",
    "test:http": "node --import tsx tests/npi-http.test.ts",
    "test:auth": "node --import tsx --test tests/auth.test.ts",
    "test:browser": "node --import tsx tests/npi-bom-browser.test.ts",
    "test:smoke": "playwright test",
    "format": "prettier --write src scripts tests vite.config.ts",
    "test:files": "node --import tsx --test tests/files.test.ts",
    "test:accounts-browser": "node --import tsx tests/accounts-browser.test.ts",
    "migrate:legacy": "node scripts/migrate-legacy.mjs",
    "test:migration": "node tests/migration.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@node-rs/argon2": "^2.0.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "hono": "^4.12.12",
    "lucide-react": "^0.544.0",
    "postgres": "^3.4.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.8",
    "esbuild": "0.28.1",
    "prettier": "3.9.5",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vite": "^7.1.7"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "esbuild": "$esbuild"
  }
}
