{
  // What `npm run typecheck:strict` checks for this package.
  //
  // Identical to `tsconfig.json` except that route files are left out. Each
  // `createFileRoute()` call is typed by the module augmentation in a generated
  // `routeTree.gen.ts`, and that tree is per-app by design — so route files are
  // checked in the app projects, which pull them in through their own tree.
  //
  // Kept separate rather than excluding them in `tsconfig.json` because ESLint's
  // `project: true` resolves the *nearest* tsconfig, and a file excluded there
  // is a file ESLint refuses to parse at all. Type-checking scope and lint
  // scope want different answers; this is the one that is only about tsc.
  "extends": "./tsconfig.json",
  // Explicit sync-conflict copies, also excluded by the CSS source scanner.
  // Canonical files remain checked; an explicit import still brings a copy in.
  "exclude": [
    "src/routes/**",
    "src/components/npi/NpiWorkspace 2.tsx",
    "src/components/npi/NpiFiles 2.tsx",
    "src/lib/npi/service 2.ts",
    "src/server/routes/npi 2.ts",
    "src/lib/items/services/ItemService 2.ts",
    "src/lib/db/schema/npi 2.ts"
  ]
}
