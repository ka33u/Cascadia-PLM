DATABASE_URL=postgres://npi:CHANGE_ME@localhost:5432/npi_workspace
BASE_URL=http://localhost:3410
PORT=3410
API_PORT=3411
HOST=127.0.0.1
ATTACHMENT_ROOT=./runtime/attachments
# 初次 setup 使用；成功后从环境移除。系统没有默认密码。
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=管理员
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD
# 自动化回归必须使用独立且以 _test 结尾的数据库。
TEST_DATABASE_URL=postgres://npi:CHANGE_ME@localhost:5432/npi_workspace_test

# Docker Compose 的数据库口令（推荐长随机字母数字串）
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_DATABASE_PASSWORD
